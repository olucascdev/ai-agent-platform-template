# Configuracao: CRM Customizado + OpenAI
# Cenario: Cliente usando CRM proprio (nao Helena) e OpenAI

# Banco de dados
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/agno_template
DATABASE_URL_MIGRATIONS=postgresql://postgres:postgres@db:5432/agno_template

# Provider de modelo - OpenAI
AGENT_MODEL_PROVIDER=openai
AGENT_MODEL_ID=gpt-4o-mini
AGENT_MODEL_API_KEY=sk-proj-...
OPENAI_API_KEY=sk-proj-...

# CRM - Customizado
# IMPORTANTE: Ajuste a URL e token para seu CRM
# Pode ser necessario criar adapter customizado em app/integrations/crm_client.py
CRM_BASE_URL=https://api.seu-crm-customizado.com
CRM_API_TOKEN=seu-token-crm-customizado
CRM_TIMEOUT=30
CRM_MAX_RETRIES=3

# WhatsApp Sender - Customizado
# IMPORTANTE: Ajuste a URL e token para seu sender
WHATSAPP_SENDER_BASE_URL=https://api.seu-sender-customizado.com
WHATSAPP_SENDER_API_TOKEN=seu-token-sender-customizado
WHATSAPP_SENDER_TIMEOUT=30
WHATSAPP_SENDER_MAX_RETRIES=3

# Preprocessor multimodal
AUDIO_TRANSCRIPTION_PROVIDER=openai
AUDIO_TRANSCRIPTION_MODEL=whisper-1
IMAGE_ANALYSIS_PROVIDER=openai
IMAGE_ANALYSIS_MODEL=gpt-4o-mini
PDF_PROCESSING_ENABLED=true

# Agente
AGENT_SESSION_PREFIX=cliente_session
AGENT_MAX_TOKENS=1000
AGENT_TEMPERATURE=0.7
AGENT_TIMEOUT=60

# Observabilidade
LOG_LEVEL=INFO
LOG_FORMAT=json
CORRELATION_ID_HEADER=X-Correlation-Id

# NOTAS:
# 1. Se seu CRM tem formato de resposta diferente, crie adapter em:
#    app/integrations/crm_client.py
# 2. Se seu Sender tem formato de payload diferente, crie adapter em:
#    app/integrations/whatsapp_sender_client.py
# 3. Consulte docs/CUSTOMIZATION.md para detalhes
