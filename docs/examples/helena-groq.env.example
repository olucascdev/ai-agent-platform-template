# ==================================================
# Exemplo de configuração usando Groq para tudo
# ==================================================
# Este exemplo mostra como configurar o template usando Groq para:
# - Agente conversacional (Llama 3.3 70B)
# - Transcrição de áudio (Whisper Large V3)
# - Análise de imagem (Llama 3.2 90B Vision)

# ==================================================
# Banco de Dados
# ==================================================
DATABASE_URL=postgresql+asyncpg://postgres:SUA_SENHA@db.abc123xyz.supabase.co:5432/postgres

# ==================================================
# API Keys
# ==================================================
# Groq API Key (usado para agente, áudio e imagem)
GROQ_API_KEY=gsk_seu_token_groq_aqui

# OpenAI API Key (opcional, apenas se quiser usar OpenAI para algo específico)
OPENAI_API_KEY=sk-opcional

# Google API Key (opcional, apenas se quiser usar Gemini para imagens)
GOOGLE_API_KEY=opcional

# ==================================================
# CRM (Helena ou outro)
# ==================================================
CRM_BASE_URL=https://api.helena.app
CRM_TOKEN=seu-token-crm-aqui

# ==================================================
# WhatsApp Sender
# ==================================================
WHATSAPP_SENDER_URL=https://api.wts.chat/chat/v1/session/{session_id}/message
WHATSAPP_TOKEN=seu-token-whatsapp-aqui

# ==================================================
# Configuração do Agente (Groq)
# ==================================================
AGENT_NAME=Helena
AGENT_SESSION_PREFIX=spacecont
AGENT_MODEL_PROVIDER=groq
AGENT_MODEL_ID=llama-3.3-70b-versatile
AGENT_TIMEZONE=America/Sao_Paulo
AGENT_CUSTOMER_TIER=diamante

# ==================================================
# Transcrição de Áudio (Groq Whisper)
# ==================================================
AUDIO_TRANSCRIPTION_PROVIDER=groq
AUDIO_TRANSCRIPTION_MODEL=whisper-large-v3
AUDIO_TRANSCRIPTION_LANGUAGE=pt

# Modelos disponíveis no Groq:
# - whisper-large-v3 (recomendado, melhor qualidade)
# - whisper-large-v3-turbo (mais rápido)
# - distil-whisper-large-v3-en (apenas inglês, mais rápido)

# ==================================================
# Análise de Imagem (Groq Vision)
# ==================================================
IMAGE_ANALYSIS_PROVIDER=groq
IMAGE_ANALYSIS_MODEL=llama-3.2-90b-vision-preview
IMAGE_ANALYSIS_PROMPT=Descreva a imagem e extraia o texto visivel de forma organizada.

# Modelos disponíveis no Groq:
# - llama-3.2-90b-vision-preview (recomendado, melhor qualidade)
# - llama-3.2-11b-vision-preview (mais rápido, menor qualidade)

# ==================================================
# Configurações Opcionais
# ==================================================
MESSAGE_DELAY_SECONDS=3
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2
HTTP_RETRY_BACKOFF_SECONDS=0.5
AUDIO_DOWNLOAD_TIMEOUT_SECONDS=20
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=20
PDF_PROCESSING_PROVIDER=pypdf
PDF_PROCESSING_MAX_PAGES=20
PDF_DOWNLOAD_TIMEOUT_SECONDS=20

# ==================================================
# Vantagens de usar Groq
# ==================================================
# ✅ Muito rápido (inferência em hardware especializado)
# ✅ Gratuito para uso moderado
# ✅ Suporta áudio, imagem e texto
# ✅ Modelos open-source (Llama, Whisper)
# ✅ API compatível com OpenAI

# ==================================================
# Limitações do Groq
# ==================================================
# ⚠️ Rate limits mais restritivos no tier gratuito
# ⚠️ Menos modelos disponíveis que OpenAI
# ⚠️ Qualidade de imagem inferior ao GPT-4 Vision
# ⚠️ Contexto menor que GPT-4 (8k tokens vs 128k)

# ==================================================
# Quando usar Groq
# ==================================================
# ✅ Desenvolvimento e testes
# ✅ Clientes com baixo volume
# ✅ Quando velocidade é prioridade
# ✅ Quando custo é fator crítico
# ✅ Para validar POCs rapidamente
