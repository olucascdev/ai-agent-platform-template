# Configuracao: Producao com Supabase + OpenAI
# Cenario: Deploy em producao com banco Supabase e observabilidade completa

# Banco de dados - Supabase
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
DATABASE_URL_MIGRATIONS=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Provider de modelo - OpenAI (producao)
AGENT_MODEL_PROVIDER=openai
AGENT_MODEL_ID=gpt-4o-mini
AGENT_MODEL_API_KEY=sk-proj-...
OPENAI_API_KEY=sk-proj-...

# CRM - Helena
CRM_BASE_URL=https://api.helena.app
CRM_API_TOKEN=seu-token-helena-producao
CRM_TIMEOUT=30
CRM_MAX_RETRIES=3

# WhatsApp Sender
WHATSAPP_SENDER_BASE_URL=https://api.seu-sender.com
WHATSAPP_SENDER_API_TOKEN=seu-token-sender-producao
WHATSAPP_SENDER_TIMEOUT=30
WHATSAPP_SENDER_MAX_RETRIES=3

# Preprocessor multimodal
AUDIO_TRANSCRIPTION_PROVIDER=openai
AUDIO_TRANSCRIPTION_MODEL=whisper-1
IMAGE_ANALYSIS_PROVIDER=openai
IMAGE_ANALYSIS_MODEL=gpt-4o-mini
PDF_PROCESSING_ENABLED=true

# Agente - Configuracao otimizada para producao
AGENT_SESSION_PREFIX=prod_session
AGENT_MAX_TOKENS=800
AGENT_TEMPERATURE=0.5
AGENT_TIMEOUT=45

# Observabilidade - Producao
LOG_LEVEL=INFO
LOG_FORMAT=json
CORRELATION_ID_HEADER=X-Correlation-Id

# Seguranca
API_SECRET_KEY=sua-chave-secreta-super-segura-aqui
ALLOWED_ORIGINS=https://app.cliente.com,https://admin.cliente.com

# NOTAS DE PRODUCAO:
# 1. Use secrets manager (AWS Secrets Manager, GCP Secret Manager, etc.)
# 2. Configure backup automatico do banco
# 3. Configure monitoramento (Sentry, DataDog, etc.)
# 4. Configure rate limiting no API Gateway
# 5. Use CDN para assets estaticos
# 6. Configure auto-scaling baseado em metricas
