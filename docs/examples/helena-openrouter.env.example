# Configuracao: Helena CRM + OpenRouter
# Cenario: Cliente usando Helena como CRM e OpenRouter para acesso a multiplos modelos

# Banco de dados
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/agno_template
DATABASE_URL_MIGRATIONS=postgresql://postgres:postgres@db:5432/agno_template

# Provider de modelo - OpenRouter (Claude 3.5 Sonnet)
AGENT_MODEL_PROVIDER=openrouter
AGENT_MODEL_ID=anthropic/claude-3.5-sonnet
OPENROUTER_API_KEY=sk-or-v1-...

# Preprocessor multimodal - OpenAI para Whisper e Vision
OPENAI_API_KEY=sk-proj-...
AUDIO_TRANSCRIPTION_PROVIDER=openai
AUDIO_TRANSCRIPTION_MODEL=whisper-1
IMAGE_ANALYSIS_PROVIDER=openai
IMAGE_ANALYSIS_MODEL=gpt-4o-mini

# CRM - Helena
CRM_BASE_URL=https://api.helena.app
CRM_API_TOKEN=seu-token-helena-aqui
CRM_TIMEOUT=30
CRM_MAX_RETRIES=3

# WhatsApp Sender
WHATSAPP_SENDER_BASE_URL=https://api.seu-sender.com
WHATSAPP_SENDER_API_TOKEN=seu-token-sender-aqui
WHATSAPP_SENDER_TIMEOUT=30
WHATSAPP_SENDER_MAX_RETRIES=3

# Agente
AGENT_SESSION_PREFIX=agno_session
AGENT_MAX_TOKENS=1000
AGENT_TEMPERATURE=0.7
AGENT_TIMEOUT=60

# Observabilidade
LOG_LEVEL=INFO
LOG_FORMAT=json
CORRELATION_ID_HEADER=X-Correlation-Id
