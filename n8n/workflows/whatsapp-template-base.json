{
  "name": "WhatsApp Inbound Template (Env + Credentials)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-template-inbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node_webhook_inbound",
      "name": "Inbound Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -560,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_PLATFORM_BASE_URL + '/webhook/whatsapp' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-Id",
              "value": "={{ $json.body?.eventId || $json.eventId || $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body || $json }}",
        "options": {
          "timeout": "={{ Number($env.API_PLATFORM_TIMEOUT_MS || 20000) }}"
        }
      },
      "id": "node_forward_to_api",
      "name": "Forward To API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -260,
        80
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "AI Platform Header Auth"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'accepted', upstream: $json } }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "node_return_result",
      "name": "Return Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        20,
        80
      ]
    }
  ],
  "connections": {
    "Inbound Webhook": {
      "main": [
        [
          {
            "node": "Forward To API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Forward To API": {
      "main": [
        [
          {
            "node": "Return Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "00000000-0000-0000-0000-000000000901",
  "meta": {
    "templateVersion": "f09.1"
  }
}
