# Base URL of this API (without trailing slash)
API_PLATFORM_BASE_URL=http://localhost:8000

# Timeout used by HTTP Request node in ms
API_PLATFORM_TIMEOUT_MS=20000

# Credential name configured in n8n (HTTP Header Auth)
# Keep this aligned with the credential attached to "Forward To API" node.
API_PLATFORM_CREDENTIAL_NAME=AI Platform Header Auth
