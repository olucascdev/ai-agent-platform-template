# ==================================================
# Template de configuracao por cliente (obrigatorio)
# ==================================================

# Chave da OpenAI usada pelo agente principal (gpt-4.1 e whisper).
OPENAI_API_KEY=sk-seu-token-openai

# Chave Google usada para analise multimodal de imagens (Gemini).
GOOGLE_API_KEY=sua-chave-google

# DSN completo do PostgreSQL com driver asyncpg.
# Exemplo local: postgresql+asyncpg://ai:ai@localhost:5432/ai
# Exemplo Supabase: postgresql+asyncpg://postgres:[SENHA]@db.[PROJECT-REF].supabase.co:5432/postgres
# Exemplo Neon: postgresql+asyncpg://[USER]:[SENHA]@[ENDPOINT].neon.tech:5432/[DATABASE]
DATABASE_URL=postgresql+asyncpg://ai:ai@localhost:5432/ai

# URL dedicada para migrations (Alembic), opcional.
# Pode usar driver asyncpg para evitar dependencia de driver sync extra.
# Quando nao informada, a aplicacao deriva automaticamente a partir de DATABASE_URL.
# DATABASE_URL_MIGRATIONS=postgresql+asyncpg://ai:ai@localhost:5432/ai

# URL base da API do CRM (ex.: https://cliente.digisac.app/api/v1).
CRM_BASE_URL=https://seu-crm.exemplo.com/api/v1

# Token Bearer da API do CRM para busca de contato e transferencia.
CRM_TOKEN=seu-token-crm

# Parametros opcionais para adaptar o cliente CRM ao contrato de cada fornecedor.
# CRM_CONTACTS_LOOKUP_PATH=/contacts
# CRM_LOOKUP_PHONE_PARAM=phone
# CRM_LOOKUP_PHONE_VALUE_TEMPLATE={phone}
# CRM_LOOKUP_SERVICE_ID_PARAM=serviceId
# CRM_SERVICE_ID=
# CRM_TRANSFER_PATH_TEMPLATE=/contacts/{contact_id}/ticket/transfer
# CRM_AUTH_HEADER_NAME=Authorization
# CRM_AUTH_HEADER_PREFIX=Bearer

# Endpoint do sender WhatsApp usado para envio de texto.
WHATSAPP_SENDER_URL=https://seu-sender.exemplo.com/send/text

# Token de autenticacao do sender WhatsApp.
WHATSAPP_TOKEN=seu-token-whatsapp

# Parametros opcionais para adaptar o contrato do sender por cliente/provedor.
# WHATSAPP_SENDER_METHOD=POST
# WHATSAPP_SENDER_NUMBER_FIELD=number
# WHATSAPP_SENDER_TEXT_FIELD=text
# WHATSAPP_SENDER_AUTH_HEADER_NAME=Authorization
# WHATSAPP_SENDER_AUTH_HEADER_PREFIX=Bearer

# Nome comercial do agente exibido no contexto do prompt.
AGENT_NAME=Luna

# Prefixo de sessao para evitar colisao entre clientes no mesmo banco.
AGENT_SESSION_PREFIX=spacecont

# Intervalo entre mensagens quebradas para envio no WhatsApp (em segundos).
MESSAGE_DELAY_SECONDS=3

# Timeout padrao para chamadas HTTP em integracoes externas (em segundos).
HTTP_TIMEOUT_SECONDS=10

# Quantidade maxima de retries para chamadas HTTP externas.
HTTP_MAX_RETRIES=2

# Backoff base entre retries HTTP (em segundos, exponencial por tentativa).
HTTP_RETRY_BACKOFF_SECONDS=0.5

# Parametros opcionais da transcricao de audio (fase 5.2).
# AUDIO_TRANSCRIPTION_PROVIDER=openai
# AUDIO_TRANSCRIPTION_MODEL=whisper-1
# AUDIO_TRANSCRIPTION_LANGUAGE=pt
# AUDIO_DOWNLOAD_TIMEOUT_SECONDS=20

# Parametros opcionais da analise de imagem (fase 5.3).
# IMAGE_ANALYSIS_PROVIDER=google
# IMAGE_ANALYSIS_MODEL=models/gemini-2.0-flash-lite
# IMAGE_ANALYSIS_PROMPT=Descreva a imagem e extraia o texto visivel de forma organizada.
# IMAGE_DOWNLOAD_TIMEOUT_SECONDS=20

# Parametros opcionais do processamento de PDF (fase 5.4).
# PDF_PROCESSING_PROVIDER=pypdf
# PDF_PROCESSING_MAX_PAGES=20
# PDF_DOWNLOAD_TIMEOUT_SECONDS=20

# Mensagem padrao para fallback seguro quando midia/provider falhar.
# MEDIA_FAILURE_FALLBACK_TEXT=Nao foi possivel processar completamente a midia enviada. Oriente o usuario a reenviar o conteudo em texto ou em formato suportado.
